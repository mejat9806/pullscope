{
  "name": "pullscope-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --format=iife --target=es2022 --jsx=automatic --jsx-import-source=preact --outfile=../ui/app.js",
    "watch": "npm run build -- --watch",
    "check": "tsc --noEmit && sh no-any.sh",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" eslint.config.mjs \"eslint/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" eslint.config.mjs \"eslint/*.mjs\""
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^4.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  }
}
