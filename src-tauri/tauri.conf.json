{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pullscope",
  "version": "0.1.22",
  "identifier": "dev.local.github-pr-view",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Pullscope",
        "width": 1280,
        "height": 1000,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GitHub pull request viewer",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFQUQ1ODMyQjUwRTQzRjYKUldUMlF3NjFNbGl0SGp3bzlka3I3RDdTeUhyWDRyOTlxVXp5NFRrRVJtdVpieXJUMlpYc0s2dlkK",
      "endpoints": [
        "https://github.com/mejat9806/pullscope/releases/latest/download/latest.json"
      ]
    }
  }
}
